<mujocoinclude>
  <worldbody>
    <!-- Movable box obstacle for collision avoidance testing -->
    <!-- Box: size 0.04 x 1.0 x 0.04 (full), half-size (0.02, 0.5, 0.02), length 1.0 along y-axis -->
    <body name="obstacle_box_body" pos="0.307 0 0.411">
      <joint name="obstacle_box_joint" type="free" damping="0.1"/>
      <geom name="obstacle_box" type="box" size="0.01 0.4 0.01"
            rgba="0.8 0.3 0.3 1"/>
      <inertial pos="0 0 0" mass="0.5" diaginertia="0.001 0.001 0.001"/>
    </body>

    <!-- Fixed box on the ground -->
    <!-- Box: size 0.1 x 1.0 x 0.4 (full), half-size (0.05, 0.5, 0.2), bottom center on ground -->
    <geom name="ground_box" type="box" size="0.05 0.5 0.2" pos="0.307 0 0.2"
          rgba="0.3 0.8 0.3 1"/>

    <!-- Fixed cylindrical obstacles -->
    <!-- Cylinder 1: radius 0.05, height 0.4, center at (0.4, 0, 0.2), along y-axis -->
    <geom name="cylinder_1" type="cylinder" size="0.03 0.18" pos="0.45 0 0.3" euler="1.5708 0 0"
          rgba="0.5 0.5 0.8 1"/>
    <!-- Cylinder 2: radius 0.05, height 0.4, center at (0.4, 0, 0.8), along y-axis -->
    <geom name="cylinder_2" type="cylinder" size="0.03 0.18" pos="0.45 0 0.6" euler="1.5708 0 0"
          rgba="0.5 0.5 0.8 1"/>

  </worldbody>
</mujocoinclude>